{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public/fonts/Manrope-Report.ttf,demo/AGROMAX_SUPABASE_DEMO.sql,commercial/db/migrations/0008_platform_history.sql,commercial/db/migrations/0009_terra_brain.sql}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__agromax_route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
